# Entorno
APP_ENV=development
APP_RULES_VERSION=media-mvp-v0.1
TZ_DISPLAY=America/Panama

# Datos: el starter apunta a datos sintéticos de prueba.
# Cuando recibas el snapshot oficial, cambia estas rutas a data/snapshot/...
NEWS_CSV=data/sample/noticias.csv
INDICATORS_CSV=data/sample/indicadores.csv
PROCESSED_DIR=data/processed
REPORT_DIR=reports/data_quality

# Integraciones futuras: NO son necesarias para el Bloque 1.
# Mantener secretos fuera del código, capturas, logs y Notion público.
OPENAI_API_KEY=
OPENAI_MODEL=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Embeddings semánticos (opcional; siguiente comparación IA/NLP)
SEMANTIC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_EMBEDDINGS_DIR=data/embeddings

# Aplicación profesional
APP_NAME=TVN Media Copilot
APP_VERSION=0.7.0
DATABASE_PATH=data/app.duckdb
PROCESSED_NEWS_CSV=data/processed/noticias_ready.csv
INDICATORS_CSV=data/processed/indicadores_validated.csv
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
REQUEST_TIMEOUT_SECONDS=30
RANKING_RULES_VERSION=attention-v0.1-proposed
EVIDENCE_RULES_VERSION=evidence-v0.1-proposed
NEXT_PUBLIC_API_URL=http://localhost:8000

# Ingesta real de datos
NEWS_START_DATE=2025-10-02
NEWS_END_DATE=2026-09-30
TVN_RSS_URL=https://www.tvn-2.com/rss/
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_CHUNK_DAYS=7
GDELT_MAX_RECORDS=250
WORLDBANK_BASE_URL=https://api.worldbank.org/v2
WORLDBANK_START_YEAR=2010
WORLDBANK_END_YEAR=2024
RAW_DIR=data/raw
SNAPSHOT_DIR=data/snapshot
INGESTION_USER_AGENT=TVNMediaCopilotHackathon/0.6
INGESTION_REQUEST_DELAY_SECONDS=0.25

# Reintentos para errores transitorios 408/429/5xx
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_SECONDS=1.0

# Cache reproducible para demo/offline
GENERATION_CACHE_DIR=data/cache/generation
ALLOW_CACHED_GENERATION=true
